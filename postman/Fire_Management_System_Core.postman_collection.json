						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": \"{{firefighterId}}\",\n    \"station_id\": \"{{stationId}}\",\n    \"check_in_latitude\": 37.774900,\n    \"check_in_longitude\": -122.419400\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/shifts/check-in",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"shifts",
								"check-in"
							]
						},
						"description": "Performs shift check-in for the firefighter (Bob). The coordinates match the station coordinates. Sets status to ACTIVE. Saves the shift ID to `{{shiftId}}`."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Incidents & Operations",
			"item": [
				{
					"name": "4.1 Submit Citizen Complaint",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.id) {",
									"    pm.collectionVariables.set(\"complaintId\", jsonData.id);",
									"    pm.collectionVariables.set(\"categoryId\", jsonData.categoryId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reporterId\": \"{{citizenId}}\",\n    \"categoryId\": \"{{categoryId}}\",\n    \"latitude\": 37.774900,\n    \"longitude\": -122.419400,\n    \"severity\": \"HIGH\",\n    \"description\": \"Large smoke billowing from commercial structure near Lafayette St.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/complaints",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"complaints"
							]
						},
						"description": "Citizen reports a fire complaint. Note: Since the categories are seeded automatically at startup (RESIDENTIAL_FIRE, WILDFIRE, HAZMAT, MEDICAL_EMERGENCY), we will extract the first seeded category ID in our verification script."
					},
					"response": []
				},
				{
					"name": "4.2 Escalate Complaint to Incident",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.id) {",
									"    pm.collectionVariables.set(\"incidentId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"complaintId\": \"{{complaintId}}\",\n    \"stationId\": \"{{stationId}}\",\n    \"categoryId\": \"{{categoryId}}\",\n    \"severity\": \"HIGH\",\n    \"latitude\": 37.774900,\n    \"longitude\": -122.419400,\n    \"notes\": \"Escalated by dispatcher. Dispatching Station 1 Units.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/incidents",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"incidents"
							]
						},
						"description": "Administrator escalates the reported complaint to an incident and assigns it to SFFD Station 1. The complaint's status transitions to APPROVED. The incident starts as DISPATCHED."
					},
					"response": []
				},
				{
					"name": "4.3 Transition Incident to IN_PROGRESS",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{firefighterToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"IN_PROGRESS\",\n    \"notes\": \"Engine 1 has arrived on scene and deployed hose lines.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/incidents/{{incidentId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"incidents",
								"{{incidentId}}",
								"status"
							]
						},
						"description": "Bob the Firefighter transitions the incident state to IN_PROGRESS."
					},
					"response": []
				},
				{
					"name": "4.4 Resolve Incident",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{firefighterToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"RESOLVED\",\n    \"notes\": \"Structure fire is extinguished. All hot spots cooled. Station 1 units returning to base.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/incidents/{{incidentId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"incidents",
								"{{incidentId}}",
								"status"
							]
						},
						"description": "Bob the Firefighter resolves the incident."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Check-out & Wrap-up",
			"item": [
				{
					"name": "5.1 Shift Check-out (Bob the Firefighter)",
