							"raw": "{\n    \"shift_id\": \"{{shiftId}}\",\n    \"check_out_latitude\": 37.775600,\n    \"check_out_longitude\": -122.419400\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/shifts/check-out",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"shifts",
								"check-out"
							]
						},
						"description": "Checks out firefighter. Distance from station coordinates (37.7749, -122.4194) to check-out location (37.7756, -122.4194) is approx 77m. Since it is within the 500m geofence, status updates to COMPLETED."
					},
					"response": []
				}
			]
		}
