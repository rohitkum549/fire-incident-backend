# Fire Management System - Environment Configurations Example
# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

# Server Configuration
PORT=8080

# Database Configuration (Supabase PostgreSQL / Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fire_management
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_SCHEMA=public
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Security & JWT Configurations
# The issuer URI matches the Identity Provider endpoint (e.g. Supabase Auth, Keycloak, or local issuer)
JWT_ISSUER=http://localhost:8080
# JWK Set URI to verify signatures if asymmetric algorithms (RS256) are used
JWT_JWK_SET_URI=
# Symmetric JWT Secret used for signing local test tokens (min 256-bit key)
JWT_SECRET=your_32_character_hex_or_base64_encoded_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configurations (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
